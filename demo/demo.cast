[2.752692, "o", "\u001b[?2004l\r"]
[2.755248, "o", "SIP/RTP signaling & media quality monitor (passive, pcap-based)\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m \u001b[1msipmon\u001b[0m [OPTIONS] [FILE] [COMMAND]\r\n\r\n\u001b[1m\u001b[4mCommands:\u001b[0m\r\n  \u001b[1mlive\u001b[0m    Live capture from a network interface\r\n  \u001b[1mfile\u001b[0m    Analyze a pcap/pcapng file\r\n  \u001b[1mrecord\u001b[0m  Record a live capture into a binary event log (headless, daemonizable)\r\n  \u001b[1mreplay\u001b[0m  Replay a sipmon event log\r\n  \u001b[1mquery\u001b[0m   Query one Call-ID from an event log (script friendly)\r\n  \u001b[1mexport\u001b[0m  Export an event log to JSONL\r\n  \u001b[1mhelp\u001b[0m    Print this message or the help of the given subcommand(s)\r\n\r\n\u001b[1m\u001b[4mArguments:\u001b[0m\r\n  [FILE]  Default capture source: a .pcap/.pcapng file to analyze, or a .evlog to replay. Equivalent to `sipmon file -r FILE` / `sipmon replay -l FILE`\r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n      \u001b[1m--no-tui\u001b[0m\r\n          Headless: no TUI, print final per-call JSON (for default FILE mode)\r\n      \u001b[1m--dry-run\u001b[0m\r\n          In-memory only: no event-log writer thread, no continuous files\r\n      \u001b[1m--max-calls\u001b[0m <MAX_CALLS>\r\n          Max retained calls (evict oldest terminated first) [default: 100000]\r\n      \u001b[1m--max-streams\u001b[0m <MAX_STREAMS>\r\n          Max retained RTP streams [default: 50000]\r\n      \u001b[1m--max-diagnostics\u001b[0m <MAX_DIAGNOSTICS>\r\n          Max retained diagnostics (ring) [default: 50000]\r\n      \u001b[1m--diag-level\u001b[0m <DIAG_LEVEL>\r\n          Minimum diagnostic level: info|warn|critical [default: warn]\r\n      \u001b[1m--turn-servers\u001b[0m <TURN_SERVERS>\r\n          Comma-separated TURN server IPs (optional; also auto-learned)\r\n      \u001b[1m--raw-truncate\u001b[0m <RAW_TRUNCATE>\r\n          Truncate stored raw SIP messages to N bytes\r\n      \u001b[1m--bucket\u001b[0m <BUCKET>\r\n          Heatmap bucket granularity: 15m|1h|1d [default: 15m]\r\n  \u001b[1m-w\u001b[0m, \u001b[1m--evlog\u001b[0m <EVLOG>\r\n          Write the binary event log to this path\r\n      \u001b[1m--export-jsonl\u001b[0m <EXPORT_JSONL>\r\n          Export final snapshot as JSONL on exit\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--help\u001b[0m\r\n          Print help\r\n  \u001b[1m-V\u001b[0m, \u001b[1m--version\u001b[0m\r\n          Print version\r\n"]
[2.755685, "o", "\u001b[?2004hrzl@zma03:~/workspace/rs/sipmon$ "]
